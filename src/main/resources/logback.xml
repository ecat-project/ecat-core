<?xml version="1.0" encoding="UTF-8"?>
<!--
  五通道日志预算配置（目标 ≤50MB/日，全部日志目录 totalSizeCap ≤1GB 兜底）：
    1. 生命周期 lifecycle.log  INFO  marker=LIFECYCLE 路由（发射方属后续执行模型阶段）180 天 zip，cap 100MB
    2. 通讯健康 comm-health.log INFO/WARN marker=COMM 路由（发射方属后续执行模型阶段）90 天，cap 150MB
    3. 错误     error.log      WARN+ 经 ErrorRateLimitFilter 限频去重，90 天，cap 100MB
    4. 应用     app.log        INFO+ 常规主通道（承接原 ecat-all.log 全部常规输出），30 天，cap 300MB
    5. 诊断 DEBUG：默认不落盘；后续阶段经 LogManager 按集成临时开窗口（独立诊断文件 ≤100MB 自动回收），
       本配置只留结构缝（LogMarkers 常量 + 本注释），不预置 appender。
  四通道 cap 合计 650MB，为 1GB 兜底上限留出余量。
  root 与 com.ecat 默认 INFO：实测 DEBUG 占日志体积 ~90%（~40GB/日），级别下沉是止血主力。
  临时开 DEBUG 排障：java -Decat.log.level=debug -jar ecat-core.jar（DEBUG 进 app.log，受 cap 兜底；
  用完即关）。测试/开发环境也可放 logback-test.xml 覆盖（logback 查找顺序 test 优先）。
-->
<configuration>
    <!-- TurboFilter: 为动态加载的JAR自动设置MDC坐标 -->
    <turboFilter class="com.ecat.core.Log.ClassLoaderCoordinateFilter"/>
    <!-- TurboFilter: WARN/ERROR 限频去重（同 logger+异常签名 3s 窗口首次全栈、重复拒绝计数、窗口收口一行汇总） -->
    <turboFilter class="com.ecat.core.Log.ErrorRateLimitFilter"/>

    <!-- 注册自定义转换器 -->
    <conversionRule conversionWord="callerEx" converterClass="com.ecat.core.Utils.CallerDataConverter" />
    <conversionRule conversionWord="coordinate" converterClass="com.ecat.core.Utils.CoordinateConverter"/>
    <conversionRule conversionWord="traceId" converterClass="com.ecat.core.Utils.Mdc.TraceIdConverter"/>

    <!-- 日志输出格式 -->
    <property name="log.pattern" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%callerEx] - %msg%n" />
    <property name="log.pattern.coordinate" value="%d{HH:mm:ss.SSS} [%traceId] [%coordinate] [%thread] %-5level %logger{36} - %msg%n" />
    <!-- 生命周期/通讯健康通道：一行一事（状态转移），带完整日期与 marker（通道标识），grep 设备即得全史 -->
    <property name="log.pattern.channel" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%marker] [%coordinate] [%thread] %-5level %logger{36} - %msg%n" />

    <!-- 日志存放目录（相对 core 启动目录）；可经 -DLOG_DIR=... 覆盖（配置装载测试注入临时目录复用本配置） -->
    <property name="log.path" value="${LOG_DIR:-logs}" />

    <!-- 控制台输出：dev 用，保持同步（%callerEx 依赖调用点数据）；生产 stdout 由启动脚本重定向为 core-api.log -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>

    <!-- ==================== 通道 1：生命周期 lifecycle.log ==================== -->
    <appender name="file_lifecycle" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/lifecycle.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/lifecycle.%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>180</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern.channel}</pattern>
        </encoder>
    </appender>
    <appender name="async_lifecycle" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <!-- queueSize*0.2：队列将满时先丢 INFO 级（logback 保 WARN+），转移路径日志不在丢弃优先级 -->
        <discardingThreshold>51</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <filter class="com.ecat.core.Log.MarkerRoutingFilter">
            <marker>LIFECYCLE</marker>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <appender-ref ref="file_lifecycle"/>
    </appender>

    <!-- ==================== 通道 2：通讯健康 comm-health.log ==================== -->
    <!-- 本期预留：appender+marker 路由先架好；发射方（连接状态转移、每设备周期摘要）属后续执行模型阶段 -->
    <appender name="file_comm" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/comm-health.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/comm-health.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>150MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern.channel}</pattern>
        </encoder>
    </appender>
    <appender name="async_comm" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>51</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <filter class="com.ecat.core.Log.MarkerRoutingFilter">
            <marker>COMM</marker>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <appender-ref ref="file_comm"/>
    </appender>

    <!-- ==================== 通道 3：错误 error.log（WARN+，限频后） ==================== -->
    <appender name="file_error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern.coordinate}</pattern>
        </encoder>
    </appender>
    <appender name="async_error" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>51</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <!-- 已划入生命周期/通讯健康通道的事件不再双写进错误通道 -->
        <filter class="com.ecat.core.Log.MarkerRoutingFilter">
            <marker>LIFECYCLE</marker>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="com.ecat.core.Log.MarkerRoutingFilter">
            <marker>COMM</marker>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <appender-ref ref="file_error"/>
    </appender>

    <!-- ==================== 通道 4：应用 app.log（INFO+ 主通道） ==================== -->
    <appender name="file_app" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 预算表：应用通道按天 + 50MB 上限 -->
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern.coordinate}</pattern>
        </encoder>
    </appender>
    <appender name="async_app" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>51</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <!-- 已划入专属通道的事件不双写进应用通道 -->
        <filter class="com.ecat.core.Log.MarkerRoutingFilter">
            <marker>LIFECYCLE</marker>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="com.ecat.core.Log.MarkerRoutingFilter">
            <marker>COMM</marker>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <appender-ref ref="file_app"/>
    </appender>

    <!-- 广播 Appender: 将日志推送到 SSE（Web 日志页实时流），内存通道不落盘、不异步化 -->
    <appender name="broadcast" class="com.ecat.core.Log.LogBroadcastAppender"/>

    <!-- 日志级别控制 -->
    <!-- ecat 核心与全部动态集成；默认 info（实测 DEBUG ~40GB/日），临时排障 -Decat.log.level=debug -->
    <logger name="com.ecat" level="${ecat.log.level:-info}" additivity="false">
        <appender-ref ref="console" />
        <appender-ref ref="async_lifecycle" />
        <appender-ref ref="async_comm" />
        <appender-ref ref="async_error" />
        <appender-ref ref="async_app" />
        <appender-ref ref="broadcast" />
    </logger>

    <!-- ruoyi 框架日志级别（实测其 INFO 量可忽略，噪声源不在 ruoyi 侧） -->
    <logger name="com.ruoyi" level="info" />
    <logger name="org.springframework" level="warn" />

    <!-- 根日志级别 -->
    <root level="info">
        <appender-ref ref="console" />
        <appender-ref ref="async_error" />
        <appender-ref ref="async_app" />
        <appender-ref ref="broadcast" />
    </root>
</configuration>
